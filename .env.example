# ==============================================================================
# Backend API Configuration
# ==============================================================================
BACKEND_URL=http://localhost:3001
WORKER_API_KEY=your_worker_api_key_here

# ==============================================================================
# AWS S3 Storage Configuration
# ==============================================================================
S3_ACCESS_KEY_ID=your_s3_access_key_id
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
S3_REGION=eu-central-1
S3_BUCKET=your_s3_bucket_name
# Optional custom endpoint (for MinIO or LocalStack):
# AWS_ENDPOINT_URL=http://localhost:4566

# ==============================================================================
# AWS SQS Queue Configuration
# ==============================================================================
SQS_ACCESS_KEY_ID=your_sqs_access_key_id
SQS_SECRET_ACCESS_KEY=your_sqs_secret_access_key
SQS_REGION=eu-central-1
SQS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/your-account-id/video-processing
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=7200


# ==============================================================================
# Worker General Settings
# ==============================================================================
CLEANUP_TEMP=true
# Optional custom paths to ffmpeg/ffprobe binaries:
# FFMPEG_PATH=
# FFPROBE_PATH=
# Optional production performance tuning:
# FFMPEG_THREADS=0           # 0 = auto, or set e.g. 4 to cap CPU usage
# FFMPEG_TIMEOUT_SECONDS=3600 # 1 hour per rendition
# S3_UPLOAD_CONCURRENCY=8    # Parallel thread pool workers for HLS chunk upload
# MIN_FREE_DISK_GB=5.0       # Minimum required free disk space before job starts
# STALE_TEMP_HOURS=24        # Clean up crashed temp directories older than 24h
# MAX_SQS_RETRIES=3          # Retries on transient failure before discarding

